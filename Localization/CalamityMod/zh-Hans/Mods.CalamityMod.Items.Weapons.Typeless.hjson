Aestheticus: {
	DisplayName: 美学魔杖
	Tooltip:
		'''
		发射爆炸水晶并造成[cbuff:CalamityMod/Vaporfied]减益
		{$Common.AverageDamageInfo}
		'''
}

ClaretCannon: {
	DisplayName: 深红手炮
	Tooltip:
		'''
		发射一发超浓缩深红子弹
		深红子弹在命中敌怪时爆炸，并释放出血珠
		爆炸将撕碎敌怪并巨幅降低其防御
		捡起这些血珠会减少[cbuffplr:PotionSickness]的持续时间
		没有[cbuffplr:PotionSickness]时，将会增强自然生命再生
		每10秒钟只能发射一次
		{$Common.AverageDamageInfo}
		'''
}

ColdheartIcicle: {
	DisplayName: 寒心冰柱
	Tooltip: “冰之杰作”
}

EyeofMagnus: {
	DisplayName: 马格努斯之眼
	Tooltip:
		'''
		发射追踪宇宙物质，命中时恢复生命和魔力
		爆炸成让敌人被[cbuff:CalamityMod/MarkedforDeath]的星云
		{$Common.AverageDamageInfo}
		'''
}

LunicEye: {
	DisplayName: 星光之眼
	Tooltip:
		'''
		发射让敌人被[cbuff:CalamityMod/MarkedforDeath]的追踪能量矢
		{$Common.AverageDamageInfo}
		'''
}

RelicOfDeliverance: {
	DisplayName: 渡魂圣物
	Tooltip:
		'''
		按住<left>骑乘并充能长矛，释放左键后向你的光标冲刺
		冲刺速度取决于充能程度，当有Boss存活时速度降低
		冲刺可以撞击穿过敌怪，也能穿过物块
		<right>脱离长矛
		举起这柄长矛会大幅降低所有召唤物的伤害
		[c/FF8C00:复仇驱使着我，我的脑海中别无他物，唯有复仇。]
		[c/FF8C00:巨龙从我身上夺走了一切，支离破碎，散落一地。]
		[c/FF8C00:但当我在她身边起舞时，方知有物值得为之而战。]
		'''
}

Skynamite: {
	DisplayName: 天蓝炸药
	Tooltip:
		'''
		扔出一个无视重力的悬浮炸药
		”你无需精通空气动力学就能扔这玩意“
		'''
}

StarStruckWater: {
	DisplayName: 星水
	Tooltip: 向一些物块蔓延星辉瘟疫
}

StratusSphere: {
	DisplayName: 幻云天球
	Tooltip:
		'''
		发射一个奇点，对周围大范围区域内的实体产生影响
		受影响的玩家会随时间生成星芒，飞行时间耗尽后可以消耗星芒继续飞行
		<right>使星芒形成屏障，受伤时失去星芒而不是生命值
		发射奇点会取消屏障，而产生屏障时会取消奇点
		{$Common.AverageDamageInfo}
		“将灵魂引入星辰，何其虚妄”
		'''
}
